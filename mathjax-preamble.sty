%% ===========================================================================
%%  mathjax-preamble.sty —— Obsidian 公式自定义宏（只放"简写"，不放修复）
%% ===========================================================================
%%  作用：由 obsidian-latex（Extended MathJax）插件在启动时读取，
%%        内容交给 MathJax 解析，把下面的宏注册为全局可用。
%%  位置：库根目录，需与插件设置 preamblePath 一致（已设为 mathjax-preamble.sty）。
%%
%%  实测结论（MathJax 3.2.2 + 全部官方包，离线逐条验证过）：
%%    \complement  \varnothing  \dfrac  \operatorname  \mid  \varphi
%%    \not\subseteq  \lVert  \lvert  \langle  \overset  \blacksquare
%%    以上这些 **本来就是 MathJax 原生支持的，不需要在这里定义**（定义了也是白定义）。
%%  → 本文件不修任何"坏掉"的公式，只提供打字更快的简写。
%%     不想要其中任何一个，删掉对应那行即可，互不影响。
%%
%%  验证方法：对每个宏比较"注入本文件前 / 后"的渲染结果——
%    注入前是红字报错、注入后正确，才算真有用。本文件 55 个宏全部通过了这条判据，
%    另有 10 条真实公式（连续定义、重要极限、补集、线代综合、偏微分方程等）回归通过。
%%
%%  注意：只能用 \newcommand / \def 定义宏，不要放普通公式；
%%        插件没有错误兜底，本文件有任何一处报错都会导致整份失效。
%% ===========================================================================

%% ---------------------------------------------------------------------------
%%  1. 数集简写（写 $\R^n$ 比 $\mathbb{R}^n$ 快得多）
%% ---------------------------------------------------------------------------
\newcommand{\R}{\mathbb{R}}
\newcommand{\C}{\mathbb{C}}
\newcommand{\N}{\mathbb{N}}
\newcommand{\Z}{\mathbb{Z}}
\newcommand{\Q}{\mathbb{Q}}
\newcommand{\F}{\mathbb{F}}
\newcommand{\Ee}{\mathbb{E}}
\newcommand{\Pp}{\mathbb{P}}

%% ---------------------------------------------------------------------------
%%  2. 常用算子（行内直接 \rank(A)，不用每次敲 \operatorname{rank}）
%% ---------------------------------------------------------------------------
\newcommand{\rank}{\operatorname{rank}}
\newcommand{\tr}{\operatorname{tr}}
\newcommand{\diag}{\operatorname{diag}}
\newcommand{\Span}{\operatorname{span}}
\newcommand{\sgn}{\operatorname{sgn}}
\newcommand{\card}{\operatorname{card}}
\newcommand{\ord}{\operatorname{ord}}
\newcommand{\lcm}{\operatorname{lcm}}
\newcommand{\Var}{\operatorname{Var}}
\newcommand{\Cov}{\operatorname{Cov}}
\newcommand{\Ker}{\operatorname{Ker}}
\newcommand{\Img}{\operatorname{Im}}
\newcommand{\grad}{\operatorname{grad}}
\newcommand{\Div}{\operatorname{div}}
\newcommand{\curl}{\operatorname{curl}}
\newcommand{\proj}{\operatorname{proj}}

%% ---------------------------------------------------------------------------
%%  3. 线性代数记号（高等代数笔记最常用）
%% ---------------------------------------------------------------------------
\newcommand{\trans}{^{\mathsf{T}}}                       %% A\trans  →  Aᵀ
\newcommand{\inv}{^{-1}}                                 %% A\inv    →  A⁻¹
\newcommand{\inner}[2]{\left\langle #1,\, #2 \right\rangle}
\newcommand{\norm}[1]{\left\lVert #1 \right\rVert}
\newcommand{\abs}[1]{\left\lvert #1 \right\rvert}

%% ---------------------------------------------------------------------------
%%  4. 分析/微积分记号（数学分析笔记最常用）
%% ---------------------------------------------------------------------------
\newcommand{\dd}{\,\mathrm{d}}                           %% \dd x     →  dx（正体 d）
\newcommand{\ee}{\mathrm{e}}                             %% \ee^x     →  eˣ（正体 e）
\newcommand{\ii}{\mathrm{i}}                             %% \ii       →  虚数单位
\newcommand{\pd}[2]{\dfrac{\partial #1}{\partial #2}}     %% \pd{u}{x}
\newcommand{\pdd}[2]{\dfrac{\partial^{2} #1}{\partial #2^{2}}}
\newcommand{\dv}[2]{\dfrac{\mathrm{d} #1}{\mathrm{d} #2}}
\newcommand{\od}[2]{\dfrac{\mathrm{d} #1}{\mathrm{d} #2}}   %% 与 \dv 完全等价，只为顺手
\newcommand{\eval}[1]{\left. #1 \right|}
\newcommand{\st}{\ \text{s.t.}\ }                        %% 约束条件 "s.t."
\newcommand{\defeq}{\overset{\text{def}}{=}}
\newcommand{\qed}{\blacksquare}                          %% 证毕

%% ---------------------------------------------------------------------------
%%  5. 希腊字母 / 符号短别名（配合 Latex Suite 的自动展开使用）
%% ---------------------------------------------------------------------------
\newcommand{\eps}{\varepsilon}
\newcommand{\vphi}{\varphi}
\newcommand{\lam}{\lambda}
\newcommand{\alp}{\alpha}
\newcommand{\bet}{\beta}
\newcommand{\Om}{\Omega}
\newcommand{\om}{\omega}

%% ---------------------------------------------------------------------------
%%  6. 竞赛常用（全国大学生数学竞赛选讲笔记）
%% ---------------------------------------------------------------------------
\newcommand{\esssup}{\operatorname*{ess\,sup}}
\newcommand{\essinf}{\operatorname*{ess\,inf}}
\newcommand{\diam}{\operatorname{diam}}
\newcommand{\dist}{\operatorname{dist}}
\newcommand{\supp}{\operatorname{supp}}
\newcommand{\vol}{\operatorname{vol}}
\newcommand{\Res}{\operatorname{Res}}
\newcommand{\ind}{\mathbf{1}}
%% ===========================================================================
